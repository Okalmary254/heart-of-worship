# Local development only. Never commit your real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Initial admin password AND session-signing secret. Use a long random value (at least 16 characters).
# The first successful admin login uses this value. After changing the password in the dashboard,
# the custom password is stored as a salted scrypt hash in Neon and this value is no longer the login password.
ADMIN_KEY=replace-with-a-long-random-secret-at-least-16-chars
